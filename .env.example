# Copy this file to .env, then replace the JWT placeholder with output from:
# openssl rand -base64 32
SPRING_PROFILES_ACTIVE=default
SPRING_APP_NAME=carwash-booking-queue-system
SERVER_PORT=8080

SECURE_PASSWORD_BCRYPT_STRENGTH=10
SECURE_PASSWORD_MIN_LENGTH=12
SECURE_PASSWORD_MAX_UTF8_BYTES=72

SECURE_JWT_ISSUER=carwash-booking-queue-system
SECURE_JWT_ACCESS_TOKEN_TTL=20m
SECURE_JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_32_BYTE_SECRET

SECURE_BOOTSTRAP_ADMIN_ENABLED=false
SECURE_BOOTSTRAP_ADMIN_USER_ID=
SECURE_BOOTSTRAP_ADMIN_FULL_NAME=
SECURE_BOOTSTRAP_ADMIN_EMAIL=
SECURE_BOOTSTRAP_ADMIN_PHONE=
SECURE_BOOTSTRAP_ADMIN_PASSWORD=

# Booking policies
CARWASH_BOOKING_MAX_ACTIVE_PER_SLOT=1
CARWASH_BOOKING_CANCELLATION_WINDOW=PT0S

# Notification policies
CARWASH_NOTIFICATION_RECENT_LIMIT=10

# Queue policies
CARWASH_QUEUE_DEFAULT_SERVICE_DURATION=PT10M

# Runtime
CARWASH_TIME_ZONE=UTC
