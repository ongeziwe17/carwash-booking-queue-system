# Copy this file to .env, then replace the JWT placeholder with output from:
# openssl rand -base64 32
SPRING_PROFILES_ACTIVE=default
SPRING_APP_NAME=carwash-booking-queue-system
SERVER_PORT=8080

# PostgreSQL profile (Docker Compose activates it for the API).
POSTGRES_DB=carwash
POSTGRES_USER=carwash
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/carwash
SPRING_DATASOURCE_USERNAME=carwash
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
SPRING_DATASOURCE_MAX_POOL_SIZE=20
SPRING_DATASOURCE_MIN_IDLE=2
SPRING_DATASOURCE_CONNECTION_TIMEOUT_MS=30000

SECURE_PASSWORD_BCRYPT_STRENGTH=10
SECURE_PASSWORD_MIN_LENGTH=12
SECURE_PASSWORD_MAX_UTF8_BYTES=72

SECURE_JWT_ISSUER=carwash-booking-queue-system
SECURE_JWT_ACCESS_TOKEN_TTL=20m
SECURE_JWT_SECRET=REPLACE_WITH_BASE64_ENCODED_32_BYTE_SECRET

SECURE_BOOTSTRAP_ADMIN_ENABLED=false
SECURE_BOOTSTRAP_ADMIN_USER_ID=
SECURE_BOOTSTRAP_ADMIN_FULL_NAME=
SECURE_BOOTSTRAP_ADMIN_EMAIL=
SECURE_BOOTSTRAP_ADMIN_PHONE=
SECURE_BOOTSTRAP_ADMIN_PASSWORD=

# Booking policies
CARWASH_BOOKING_MAX_ACTIVE_PER_SLOT=1
CARWASH_BOOKING_CANCELLATION_WINDOW=PT0S
CARWASH_BOOKING_OPERATING_START=08:00
CARWASH_BOOKING_OPERATING_END=17:00
CARWASH_BOOKING_SLOT_INTERVAL=PT30M

# Notification policies
CARWASH_NOTIFICATION_RECENT_LIMIT=10

# Queue policies
CARWASH_QUEUE_DEFAULT_SERVICE_DURATION=PT10M

# Explainable recommendation policies (weights must sum exactly to 1)
CARWASH_RECOMMENDATION_WEIGHT_DISTANCE=0.25
CARWASH_RECOMMENDATION_WEIGHT_QUEUE_WAIT=0.25
CARWASH_RECOMMENDATION_WEIGHT_TOTAL_TIME=0.25
CARWASH_RECOMMENDATION_WEIGHT_PRICE=0.25
CARWASH_RECOMMENDATION_MAX_RADIUS_KM=50.00

# Runtime
CARWASH_TIME_ZONE=UTC

# Immutable audit history and bounded read policy
CARWASH_AUDIT_RETENTION_PERIOD=P365D
CARWASH_AUDIT_DEFAULT_PAGE_SIZE=50
CARWASH_AUDIT_MAXIMUM_PAGE_SIZE=200
CARWASH_AUDIT_MAXIMUM_QUERY_RANGE=P90D
CARWASH_AUDIT_METADATA_MAXIMUM_KEYS=10
CARWASH_AUDIT_METADATA_MAXIMUM_KEY_LENGTH=32
CARWASH_AUDIT_METADATA_MAXIMUM_VALUE_LENGTH=256
CARWASH_AUDIT_METADATA_MAXIMUM_TOTAL_SIZE=2048
